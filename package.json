{
  "name": "hacker-news-crawler",
  "version": "4.0.0",
  "description": "Hacker News Crawler REST service - v4 feature-module architecture with Hello World scaffold",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "build": "webpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run",
    "test:acceptance": "node --import tsx node_modules/.bin/cucumber-js --import 'tests/acceptance/steps/**/*.ts' --import 'tests/acceptance/support/**/*.ts' --import 'tests/e2e/steps/**/*.ts' --import 'tests/e2e/support/**/*.ts' 'tests/acceptance/features/**/*.feature' 'tests/e2e/features/**/*.feature'",
    "test:e2e:live": "RUN_LIVE_TESTS=true vitest run tests/e2e/live",
    "test:architecture": "depcruise src --config .dependency-cruiser.cjs",
    "api:validate": "redocly lint docs/api/openapi.yaml",
    "api:docs": "redocly build-docs docs/api/openapi.yaml --output docs/api/generated/openapi.html",
    "start": "node dist/bundle.js",
    "prepare": "husky"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@redocly/cli": "^1.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "better-sqlite3": "^13.2.0",
    "cucumber-html-reporter": "^7.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.0.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
}
